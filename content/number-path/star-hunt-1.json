 "title": {
  "en": "Star Hunt",
  "hi": "तारों की खोज",
  "mr": "ताऱ्यांचा शोध",
  "gu": "તારાઓની શોધ",
  "bn": "তারার খোঁজ",
  "ta": "நட்சத்திர வேட்டை",
  "te": "నక్షత్రాల వేట",
  "kn": "ನಕ್ಷತ್ರ ಬೇಟೆ"
 },
 "about": {
  "en": "24 adding boards with two or three stars to pick up on the way to the flag.",
  "hi": "24 जोड़ वाले बोर्ड, जिनमें झंडे तक जाते हुए दो या तीन तारे साथ लेने हैं।",
  "mr": "24 बेरजेचे बोर्ड, झेंड्यापर्यंत जाताना दोन किंवा तीन तारे गोळा करायचे.",
  "gu": "24 સરવાળાના બોર્ડ, ધ્વજ સુધી જતાં બે કે ત્રણ તારા ભેગા કરવાના.",
  "bn": "24টি যোগের বোর্ড, পতাকা পর্যন্ত যাওয়ার পথে দুটি বা তিনটি তারা তুলতে হবে।",
  "ta": "கொடி வரை செல்லும் வழியில் இரண்டு அல்லது மூன்று நட்சத்திரங்களை எடுக்க வேண்டிய 24 கூட்டல் பலகைகள்.",
  "te": "జెండా వరకు వెళ్తూ రెండు లేదా మూడు నక్షత్రాలు ఏరుకోవాల్సిన 24 కూడిక బోర్డులు.",
  "kn": "ಧ್ವಜದವರೆಗೆ ಹೋಗುವಾಗ ಎರಡು ಅಥವಾ ಮೂರು ನಕ್ಷತ್ರಗಳನ್ನು ಎತ್ತಿಕೊಳ್ಳಬೇಕಾದ 24 ಕೂಡುವ ಬೋರ್ಡ್‌ಗಳು."
 },
