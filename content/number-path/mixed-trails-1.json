 "title": {
  "en": "Mixed Trails",
  "hi": "मिली-जुली राहें",
  "mr": "मिश्र वाटा",
  "gu": "મિશ્ર રસ્તા",
  "bn": "মিশ্র পথ",
  "ta": "கலவைப் பாதைகள்",
  "te": "మిశ్రమ దారులు",
  "kn": "ಮಿಶ್ರ ದಾರಿಗಳು"
 },
 "about": {
  "en": "30 fresh boards that mix adding, multiplying, plus and minus, stars and diagonal steps.",
  "hi": "30 नए बोर्ड जिनमें जोड़, गुणा, जोड़-घटा, तारे और तिरछे कदम मिले हैं।",
  "mr": "30 नवे बोर्ड: बेरीज, गुणाकार, अधिक-वजा, तारे आणि तिरकी पावले एकत्र.",
  "gu": "30 નવા બોર્ડ: સરવાળો, ગુણાકાર, વત્તા-ઓછા, તારા અને ત્રાંસાં પગલાં સાથે.",
  "bn": "30টি নতুন বোর্ড: যোগ, গুণ, যোগ-বিয়োগ, তারা আর কোনাকুনি পা একসাথে।",
  "ta": "கூட்டல், பெருக்கல், கூட்டல்-கழித்தல், நட்சத்திரங்கள், குறுக்குப் படிகள் கலந்த 30 புதிய பலகைகள்.",
  "te": "కూడిక, గుణకారం, కూడిక-తీసివేత, నక్షత్రాలు, అడ్డ అడుగులు కలిసిన 30 కొత్త బోర్డులు.",
  "kn": "ಕೂಡು, ಗುಣಾಕಾರ, ಕೂಡು-ಕಳೆ, ನಕ್ಷತ್ರಗಳು ಮತ್ತು ಓರೆ ಹೆಜ್ಜೆಗಳು ಬೆರೆತ 30 ಹೊಸ ಬೋರ್ಡ್‌ಗಳು."
 },
